    '\t// Game Constants\n' +
    '\tconst ROWS = 6;\n' +
    '\tconst COLS = 7;\n' +
    '\tconst PLAYER_1 = 1;\n' +
    '\tconst PLAYER_2 = 2;\n' +
    '\tconst COLORS = {\n' +
    '\t\tprimary: "#1976D2",  // Player 1 disc (blue)\n' +
    '\t\tsecondary: "#FFC107", // Player 2 disc (yellow)\n' +
    '\t\taccent: "#E53935"     // Highlight for wins\n' +
    '\t};\n' +
    '\n' +
    '\t// Game State\n' +
    '\tlet board: number[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(0));\n' +
    '\tlet currentPlayer: number = PLAYER_1;\n' +
    '\tlet gameOver: boolean = false;\n' +
    '\tlet winner: number | null = null;\n' +
    '\tlet animatingColumns: number[] = Array(COLS).fill(null); // For animating disc drop per column\n' +
    '\tlet winningCoords: Set<string> = new Set();\n' +
    '\n' +
    '\t/**\n' +
    '\t * PUBLIC_INTERFACE\n' +
    '\t * Handle drop action on a column, triggers disc drop for current player\n' +
    '\t */\n' +
    '\tfunction dropDisc(col: number) {\n' +
    '\t\tif (gameOver || isColumnFull(col) || animatingColumns[col] !== null) return;\n' +
    '\t\tconst row = getAvailableRow(col);\n' +
    '\t\tif (row === -1) return;\n' +
    '\n' +
    '\t\t// Animate disc drop\n' +
    '\t\tanimatingColumns = animatingColumns.slice();\n' +
    '\t\tanimatingColumns[col] = 0;\n' +
    '\n' +
    '\t\tconst animationInterval = setInterval(() => {\n' +
    '\t\t\tif (animatingColumns[col]! < row) {\n' +
    '\t\t\t\tanimatingColumns = animatingColumns.slice();\n' +
    '\t\t\t\tanimatingColumns[col]! += 1;\n' +
    '\t\t\t} else {\n' +
    '\t\t\t\tclearInterval(animationInterval);\n' +
    '\t\t\t\tboard = board.map((r, idx) => idx === row ? [...r.slice(0, col), currentPlayer, ...r.slice(col + 1)] : r.map((v) => v));\n' +
    '\t\t\t\tanimatingColumns = animatingColumns.slice();\n' +
    '\t\t\t\tanimatingColumns[col] = null;\n' +
    '\n' +
    '\t\t\t\tconst { hasWon, coords } = checkWin(row, col, currentPlayer);\n' +
    '\t\t\t\tif (hasWon) {\n' +
    '\t\t\t\t\tgameOver = true;\n' +
    '\t\t\t\t\twinner = currentPlayer;\n' +
    '\t\t\t\t\twinningCoords = coords;\n' +
    '\t\t\t\t} else if (isBoardFull()) {\n' +
    '\t\t\t\t\tgameOver = true;\n' +
    '\t\t\t\t\twinner = 0; // Tie\n' +
    '\t\t\t\t} else {\n' +
    '\t\t\t\t\tcurrentPlayer = currentPlayer === PLAYER_1 ? PLAYER_2 : PLAYER_1;\n' +
    '\t\t\t\t}\n' +
    '\t\t\t}\n' +
    '\t\t}, 50);\n' +
    '\t}\n' +
    '\n' +
    '\t/**\n' +
    '\t * Get the lowest available row index in the specified column\n' +
    '\t */\n' +
    '\tfunction getAvailableRow(col: number): number {\n' +
    '\t\tfor (let row = ROWS - 1; row >= 0; row--) {\n' +
    '\t\t\tif (board[row][col] === 0 && (animatingColumns[col] === null || animatingColumns[col] <= row)) {\n' +
    '\t\t\t\treturn row;\n' +
    '\t\t\t}\n' +
    '\t\t}\n' +
    '\t\treturn -1;\n' +
    '\t}\n' +
    '\n' +
    '\t/**\n' +
    '\t * Check if a column is full\n' +
    '\t */\n' +
    '\tfunction isColumnFull(col: number): boolean {\n' +
    '\t\treturn board[0][col] !== 0 || animatingColumns[col] !== null;\n' +
    '\t}\n' +
    '\n' +
    '\t/**\n' +
    '\t * Check if the board is full\n' +
    '\t */\n' +
    '\tfunction isBoardFull(): boolean {\n' +
    '\t\treturn board.every(row => row.every(cell => cell !== 0));\n' +
    '\t}\n' +
    '\n' +
    '\t/**\n' +
    '\t * PUBLIC_INTERFACE\n' +
    '\t * Reset the game to initial state\n' +
    '\t */\n' +
    '\tfunction resetGame() {\n' +
    '\t\tboard = Array.from({ length: ROWS }, () => Array(COLS).fill(0));\n' +
    '\t\tcurrentPlayer = PLAYER_1;\n' +
    '\t\tgameOver = false;\n' +
    '\t\twinner = null;\n' +
    '\t\tanimatingColumns = Array(COLS).fill(null);\n' +
    '\t\twinningCoords = new Set();\n' +
    '\t}\n' +
    '\n' +
    '\t/**\n' +
    '\t * PUBLIC_INTERFACE\n' +
    '\t * Check for a win condition (4 in a row, any direction).\n' +
    '\t * Returns {hasWon: boolean, coords: Set<string>} (coords are "row,col" string, for highlighting)\n' +
    '\t */\n' +
    '\tfunction checkWin(row: number, col: number, player: number): { hasWon: boolean, coords: Set<string> } {\n' +
    '\t\tconst directions = [\n' +
    '\t\t\t{ dr: 0, dc: 1 },   // horizontal\n' +
    '\t\t\t{ dr: 1, dc: 0 },   // vertical\n' +
    '\t\t\t{ dr: 1, dc: 1 },   // diagonal down right\n' +
    '\t\t\t{ dr: 1, dc: -1 }   // diagonal down left\n' +
    '\t\t];\n' +
    '\t\tfor (const { dr, dc } of directions) {\n' +
    '\t\t\tlet count = 1;\n' +
    '\t\t\tlet coords = new Set<string>([`${row},${col}`]);\n' +
    '\t\t\t// Forward\n' +
    '\t\t\tlet r = row + dr, c = col + dc;\n' +
    '\t\t\twhile (r >= 0 && r < ROWS && c >= 0 && c < COLS && board[r][c] === player) {\n' +
    '\t\t\t\tcount++;\n' +
    '\t\t\t\tcoords.add(`${r},${c}`);\n' +
    '\t\t\t\tr += dr;\n' +
    '\t\t\t\tc += dc;\n' +
    '\t\t\t}\n' +
    '\t\t\t// Backward\n' +
    '\t\t\tr = row - dr, c = col - dc;\n' +
    '\t\t\twhile (r >= 0 && r < ROWS && c >= 0 && c < COLS && board[r][c] === player) {\n' +
    '\t\t\t\tcount++;\n' +
    '\t\t\t\tcoords.add(`${r},${c}`);\n' +
    '\t\t\t\tr -= dr;\n' +
    '\t\t\t\tc -= dc;\n' +
    '\t\t\t}\n' +
    '\t\t\tif (count >= 4) {\n' +
    '\t\t\t\treturn { hasWon: true, coords };\n' +
    '\t\t\t}\n' +
    '\t\t}\n' +
    '\t\treturn { hasWon: false, coords: new Set() };\n' +
    '\t}\n' +
    '\n' +
    '\t/**\n' +
    '\t * Get disc color for a player\n' +
    '\t */\n' +
    '\tfunction getDiscColor(player: number): string {\n' +
    '\t\tif (player === PLAYER_1) return COLORS.primary;\n' +
    '\t\tif (player === PLAYER_2) return COLORS.secondary;\n' +
    '\t\treturn "transparent";\n' +
    '\t}\n' +
    '\n' +
    '\t/**\n' +
    '\t * For ARIA and accessible labeling\n' +
    '\t */\n' +
    '\tfunction getCellDesc(r: number, c: number): string {\n' +
    '\t\tconst val = board[r][c];\n' +
    '\t\tif (val === PLAYER_1) return "Blue";\n' +
    '\t\tif (val === PLAYER_2) return "Yellow";\n' +
    '\t\treturn "Empty";\n' +
    '\t}\n' +
    '</script>\n' +
